# Copy to .env (or point BTC5M_ENV_FILE at your own path) and fill in real values.
# Never commit the real .env — it is already covered by .gitignore.

# --- Polymarket CLOB auth (used directly by scripts/test_btc_5m_session_exit_sl.py) ---
PM_PRIVATE_KEY=
PM_FUNDER=
# PM_ADDRESS is an accepted alias for PM_FUNDER if that's what your setup uses
# PM_ADDRESS=
PM_SIGNATURE_TYPE=2
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Order execution tuning (passed through to pm_live_trade_runner.py via run_open) ---
PM_MAX_SPREAD=1
PM_MIN_TOP_ASK_NOTIONAL_USD=0
PM_ORDER_TYPE=FAK

# --- Position sizing / risk controls ---
# Account equity for percentage-of-equity position sizing is fetched live
# every cycle using PM_FUNDER -- no manual variable to maintain. Order tried:
#   1. On-chain USDC balance (native + bridged) via public Polygon RPC --
#      the ground-truth spendable cash, immune to any API indexing lag.
#   2. data-api.polymarket.com/value, if the on-chain check fails.
#   3. BTC5M_ACCOUNT_EQUITY_USD_FALLBACK (default 100), if both fail.
# Check account_equity_source in the JSON output to see which path was used.
#
# Only set this if you deliberately want to force a fixed value and skip all
# of the above (e.g. testing):
# BTC5M_ACCOUNT_EQUITY_USD=100
# BTC5M_ACCOUNT_EQUITY_USD_FALLBACK=100

# --- Skill runtime overrides (optional, see CONTOUR.md / SKILL.md) ---
# Path to the external execution repo (defaults to ../../pm-hl-conservative-plus-repo)
# BTC5M_REPO=/path/to/pm-hl-conservative-plus-repo
# Alternate env file to source instead of $BTC5M_REPO/.env
# BTC5M_ENV_FILE=/path/to/alternate.env
# Alternate canonical runner script
# BTC5M_RUNNER=/path/to/test_btc_5m_session_exit_sl.py
